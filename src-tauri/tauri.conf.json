{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FoeFlow",
  "version": "0.1.0",
  "identifier": "com.ecnusoe.foeflow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FoeFlow",
        "width": 1200,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' https://chat.ecnu.edu.cn http://localhost:5173 http://127.0.0.1:3000 data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/generated-images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
