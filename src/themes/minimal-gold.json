{
  "name": "minimal-gold",
  "description": "极简金风格，适合高端内容和正式场合",
  "colors": {
    "primary": "#b8860b",
    "secondary": "#daa520",
    "text": "#2c2c2c",
    "textLight": "#888888",
    "background": "#ffffff",
    "codeBg": "#faf8f0",
    "codeColor": "#b8860b",
    "quoteBorder": "#b8860b",
    "quoteBg": "#fefcf5",
    "border": "#e8e4d9"
  },
  "typography": {
    "fontFamily": "'PingFang SC', 'Microsoft YaHei', 'Hiragino Sans GB', 'Georgia', serif",
    "fontSize": "16px",
    "lineHeight": 1.85
  },
  "styles": {
    "h1": {
      "fontSize": "28px",
      "fontWeight": "300",
      "color": "primary",
      "margin": "40px 0 20px 0",
      "paddingBottom": "16px",
      "borderBottom": "1px solid primary",
      "lineHeight": "1.3",
      "textAlign": "center",
      "letterSpacing": "0.05em"
    },
    "h2": {
      "fontSize": "21px",
      "fontWeight": "400",
      "color": "text",
      "margin": "32px 0 16px 0",
      "paddingBottom": "10px",
      "borderBottom": "1px solid border",
      "lineHeight": "1.35",
      "letterSpacing": "0.03em"
    },
    "h3": {
      "fontSize": "18px",
      "fontWeight": "500",
      "color": "primary",
      "margin": "24px 0 12px 0",
      "lineHeight": "1.45",
      "letterSpacing": "0.02em"
    },
    "h4": {
      "fontSize": "17px",
      "fontWeight": "500",
      "color": "textLight",
      "margin": "20px 0 10px 0",
      "lineHeight": "1.45"
    },
    "p": {
      "fontSize": "16px",
      "lineHeight": "1.85",
      "color": "text",
      "margin": "14px 0",
      "letterSpacing": "0.01em"
    },
    "strong": {
      "fontWeight": "600",
      "color": "primary"
    },
    "em": {
      "fontStyle": "italic",
      "color": "text"
    },
    "code": {
      "fontFamily": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace",
      "fontSize": "13px",
      "background": "codeBg",
      "color": "primary",
      "padding": "2px 6px",
      "borderRadius": "2px",
      "letterSpacing": "0.01em"
    },
    "pre": {
      "background": "codeBg",
      "color": "text",
      "padding": "20px",
      "borderRadius": "2px",
      "overflowX": "auto",
      "margin": "20px 0",
      "lineHeight": "1.7",
      "border": "1px solid border"
    },
    "blockquote": {
      "background": "quoteBg",
      "margin": "20px 0",
      "padding": "16px 20px",
      "borderRadius": "4px",
      "color": "text",
      "fontStyle": "italic",
      "border": "1px solid border"
    },
    "ul": {
      "paddingLeft": "24px",
      "margin": "14px 0"
    },
    "ol": {
      "paddingLeft": "24px",
      "margin": "14px 0"
    },
    "li": {
      "fontSize": "16px",
      "lineHeight": "1.85",
      "color": "text",
      "margin": "8px 0"
    },
    "table": {
      "width": "100%",
      "borderCollapse": "collapse",
      "margin": "20px 0",
      "fontSize": "15px"
    },
    "th": {
      "background": "background",
      "color": "primary",
      "fontWeight": "600",
      "padding": "12px 14px",
      "textAlign": "left",
      "borderBottom": "2px solid primary"
    },
    "td": {
      "padding": "10px 14px",
      "border": "1px solid border",
      "color": "text"
    },
    "tr": {
      "background": "background"
    },
    "img": {
      "maxWidth": "100%",
      "height": "auto",
      "display": "block",
      "margin": "28px auto",
      "filter": "sepia(0.1)"
    },
    "a": {
      "color": "primary",
      "textDecoration": "none",
      "fontWeight": "500",
      "borderBottom": "1px solid secondary"
    },
    "hr": {
      "border": "none",
      "borderTop": "1px solid border",
      "margin": "32px 0"
    }
  }
}
