{
  "name": "warm-editorial",
  "description": "温暖编辑风格，适合生活方式和文化类内容",
  "colors": {
    "primary": "#d97706",
    "secondary": "#ea580c",
    "text": "#333333",
    "textLight": "#666666",
    "background": "#ffffff",
    "codeBg": "#fef3c7",
    "codeColor": "#92400e",
    "quoteBorder": "#d97706",
    "quoteBg": "#fffbeb",
    "border": "#fde68a"
  },
  "typography": {
    "fontFamily": "'PingFang SC', 'Microsoft YaHei', 'Hiragino Sans GB', -apple-system, BlinkMacSystemFont, sans-serif",
    "fontSize": "16px",
    "lineHeight": 1.8
  },
  "styles": {
    "h1": {
      "fontSize": "26px",
      "fontWeight": "700",
      "color": "primary",
      "margin": "32px 0 16px 0",
      "paddingBottom": "12px",
      "borderBottom": "2px solid primary",
      "lineHeight": "1.3",
      "textAlign": "center"
    },
    "h2": {
      "fontSize": "21px",
      "fontWeight": "700",
      "color": "primary",
      "margin": "28px 0 14px 0",
      "padding": "8px 12px",
      "background": "quoteBg",
      "borderRadius": "6px",
      "lineHeight": "1.35"
    },
    "h3": {
      "fontSize": "18px",
      "fontWeight": "600",
      "color": "primary",
      "margin": "24px 0 12px 0",
      "lineHeight": "1.4"
    },
    "h4": {
      "fontSize": "17px",
      "fontWeight": "600",
      "color": "textLight",
      "margin": "20px 0 10px 0",
      "lineHeight": "1.4"
    },
    "p": {
      "fontSize": "16px",
      "lineHeight": "1.8",
      "color": "text",
      "margin": "12px 0"
    },
    "strong": {
      "fontWeight": "700",
      "color": "primary"
    },
    "em": {
      "fontStyle": "italic",
      "color": "text"
    },
    "code": {
      "fontFamily": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace",
      "fontSize": "14px",
      "background": "codeBg",
      "color": "codeColor",
      "padding": "2px 6px",
      "borderRadius": "4px"
    },
    "pre": {
      "background": "codeBg",
      "color": "codeColor",
      "padding": "16px",
      "borderRadius": "8px",
      "overflowX": "auto",
      "margin": "16px 0",
      "lineHeight": "1.6",
      "border": "1px solid border"
    },
    "blockquote": {
      "background": "quoteBg",
      "margin": "16px 0",
      "padding": "14px 18px",
      "borderRadius": "8px",
      "color": "text",
      "border": "1px solid border"
    },
    "ul": {
      "paddingLeft": "24px",
      "margin": "12px 0"
    },
    "ol": {
      "paddingLeft": "24px",
      "margin": "12px 0"
    },
    "li": {
      "fontSize": "16px",
      "lineHeight": "1.8",
      "color": "text",
      "margin": "6px 0"
    },
    "table": {
      "width": "100%",
      "borderCollapse": "collapse",
      "margin": "16px 0",
      "fontSize": "15px"
    },
    "th": {
      "background": "primary",
      "color": "#ffffff",
      "fontWeight": "600",
      "padding": "10px 14px",
      "textAlign": "left",
      "border": "1px solid border"
    },
    "td": {
      "padding": "10px 14px",
      "border": "1px solid border",
      "color": "text"
    },
    "tr": {
      "background": "background"
    },
    "img": {
      "maxWidth": "100%",
      "height": "auto",
      "display": "block",
      "margin": "24px auto",
      "borderRadius": "8px"
    },
    "a": {
      "color": "primary",
      "textDecoration": "none",
      "fontWeight": "500"
    },
    "hr": {
      "border": "none",
      "borderTop": "1px solid border",
      "margin": "24px 0"
    }
  }
}
